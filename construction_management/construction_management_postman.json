{
	"info": {
		"_postman_id": "c71a3371-5555-4444-9999-construction01",
		"name": "Construction Management System API",
		"description": "Bộ sưu tập API kiểm thử hệ thống Quản lý Thi công Công trình (FastAPI)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Register Owner Account",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"owner@example.com\",\n  \"password\": \"password123\",\n  \"full_name\": \"Site Owner\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
						}
					}
				},
				{
					"name": "Login & Get Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.access_token) {",
									"    pm.environment.set(\"bearerToken\", jsonData.access_token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"owner@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				}
			]
		},
		{
			"name": "2. Users",
			"item": [
				{
					"name": "Get Current User Profile",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{bearerToken}}"}
						],
						"url": {
							"raw": "{{baseUrl}}/users/me",
							"host": ["{{baseUrl}}"],
							"path": ["users", "me"]
						}
					}
				}
			]
		},
		{
			"name": "3. Construction Sites",
			"item": [
				{
					"name": "Create Site",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{bearerToken}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Dự án Chung cư Sunrise\",\n  \"description\": \"Xây dựng khối nhà A\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/construction-sites",
							"host": ["{{baseUrl}}"],
							"path": ["construction-sites"]
						}
					}
				},
				{
					"name": "List My Sites",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{bearerToken}}"}
						],
						"url": {
							"raw": "{{baseUrl}}/construction-sites?search=Sunrise",
							"host": ["{{baseUrl}}"],
							"path": ["construction-sites"],
							"query": [
								{"key": "search", "value": "Sunrise"}
							]
						}
					}
				}
			]
		},
		{
			"name": "4. Work Items",
			"item": [
				{
					"name": "Create Work Item",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{bearerToken}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"site_id\": 1,\n  \"title\": \"Thi công ép cọc nhồi\",\n  \"description\": \"Ép cọc bê tông cốt thép móng A1\",\n  \"priority\": \"HIGH\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/construction-sites/1/work-items",
							"host": ["{{baseUrl}}"],
							"path": ["construction-sites", "1", "work-items"]
						}
					}
				},
				{
					"name": "List Site Work Items",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{bearerToken}}"}
						],
						"url": {
							"raw": "{{baseUrl}}/construction-sites/1/work-items?status=TODO&priority=HIGH",
							"host": ["{{baseUrl}}"],
							"path": ["construction-sites", "1", "work-items"],
							"query": [
								{"key": "status", "value": "TODO"},
								{"key": "priority", "value": "HIGH"}
							]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8000"
		},
		{
			"key": "bearerToken",
			"value": ""
		}
	]
}
